{
  "name": "agnostic-chat",
  "version": "0.1.0",
  "description": "An LLM-agnostic, coding-focused desktop chat app with browser access and prompt protection.",
  "main": "src/main/main.js",
  "author": "Chris",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.fluencysecurity.agnosticchat",
    "productName": "Agnostic Chat",
    "copyright": "Copyright © 2026 Chris Jordan",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/renderer/preview.html"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
